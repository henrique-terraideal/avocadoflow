{
  "name": "Operation",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo da opera\u00e7\u00e3o (ex: 01)"
    },
    "name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se a opera\u00e7\u00e3o est\u00e1 dispon\u00edvel para sele\u00e7\u00e3o"
    },
    "color": {
      "type": "string",
      "description": "Classe de cor Tailwind (ex: bg-green-500)"
    },
    "sort_order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "description": "Macrocategoria da opera\u00e7\u00e3o (ex: Irriga\u00e7\u00e3o, Poda, Colheita)"
    }
  },
  "required": [
    "name",
    "code"
  ]
}