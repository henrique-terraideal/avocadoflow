{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "active_ingredient": {
      "type": "string",
      "description": "Princípio ativo"
    },
    "target": {
      "type": "string",
      "description": "Alvo/praga controlado"
    },
    "carencia": {
      "type": "string",
      "description": "Período de carência padrão do produto (ex: '30 dias', 'Não se aplica')"
    },
    "unit": {
      "type": "string",
      "enum": ["L", "mL", "kg", "g", "t"],
      "description": "Unidade de medida do produto (L, mL, kg, g, t) — aparece na dose, Qtd/Tanque e Total da ficha de campo e da RA"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o produto está ativo"
    }
  },
  "required": [
    "name"
  ]
}
