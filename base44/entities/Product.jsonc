{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "active_ingredient": {
      "type": "string",
      "description": "Princ\u00edpio ativo"
    },
    "target": {
      "type": "string",
      "description": "Alvo/praga controlado"
    },
    "unit": {
      "type": "string",
      "enum": [
        "L",
        "mL",
        "kg",
        "g",
        "t"
      ],
      "description": "Unidade de medida do produto"
    },
    "dose_bula": {
      "type": "string",
      "description": "Dose de bula (dose recomendada pelo fabricante, em texto livre)"
    },
    "tipo_produto": {
      "type": "string",
      "enum": [
        "L\u00edquido",
        "Sal Sol\u00favel",
        "N\u00e3o se aplica"
      ],
      "description": "Tipo do produto: L\u00edquido, Sal Sol\u00favel ou N\u00e3o se aplica"
    },
    "carencia": {
      "type": "string",
      "description": "Per\u00edodo de car\u00eancia padr\u00e3o do produto (ex: '30 dias', 'N\u00e3o se aplica')"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o produto est\u00e1 ativo"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}