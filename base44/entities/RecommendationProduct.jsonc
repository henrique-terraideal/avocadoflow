{
  "name": "RecommendationProduct",
  "type": "object",
  "properties": {
    "recommendation_id": {
      "type": "string",
      "description": "ID da RA (AgronomicRecommendation) pai"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "application_mode": {
      "type": "string",
      "enum": [
        "\u00c1REA",
        "PLANTA"
      ],
      "description": "Modo de aplica\u00e7\u00e3o: por \u00e1rea (ha) ou por planta"
    },
    "dose": {
      "type": "number",
      "description": "Dose aplicada (por ha ou por planta, conforme application_mode)"
    },
    "total_quantity": {
      "type": "number",
      "description": "Quantidade total calculada"
    },
    "obs": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do produto"
    },
    "sort_order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "recommendation_id",
    "product_name"
  ]
}