{
  "name": "RecommendationProduct",
  "type": "object",
  "properties": {
    "recommendation_id": {
      "type": "string",
      "description": "ID da RA (AgronomicRecommendation) pai"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "active_ingredient": {
      "type": "string",
      "description": "Princípio ativo do produto (copiado do cadastro no momento da importação)"
    },
    "target": {
      "type": "string",
      "description": "Alvo/praga controlado (copiado do cadastro no momento da importação)"
    },
    "unit": {
      "type": "string",
      "enum": ["L", "mL", "kg", "g", "t"],
      "description": "Unidade de medida (copiada do cadastro de produto — L, mL, kg, g, t)"
    },
    "application_mode": {
      "type": "string",
      "enum": ["ÁREA", "PLANTA"],
      "description": "Modo de aplicação: por área (ha) ou por planta"
    },
    "dose": {
      "type": "number",
      "description": "Dose aplicada (por ha ou por planta, conforme application_mode)"
    },
    "total_quantity": {
      "type": "number",
      "description": "Quantidade total calculada"
    },
    "carencia": {
      "type": "string",
      "description": "Período de carência (intervalo de segurança entre aplicação e colheita, ex: '30 dias')"
    },
    "obs": {
      "type": "string",
      "description": "Observações do produto"
    },
    "sort_order": {
      "type": "number",
      "description": "Ordem de exibição"
    }
  },
  "required": [
    "recommendation_id",
    "product_name"
  ]
}
