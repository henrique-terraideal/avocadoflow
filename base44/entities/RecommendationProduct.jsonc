{
  "name": "RecommendationProduct",
  "type": "object",
  "properties": {
    "recommendation_id": {
      "type": "string",
      "description": "ID da RA (AgronomicRecommendation) pai"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "active_ingredient": {
      "type": "string",
      "description": "Princ\u00edpio ativo do produto (copiado do cadastro no momento da importa\u00e7\u00e3o)"
    },
    "target": {
      "type": "string",
      "description": "Alvo/praga controlado (copiado do cadastro no momento da importa\u00e7\u00e3o)"
    },
    "unit": {
      "type": "string",
      "description": "Unidade de medida (copiada do cadastro do produto)"
    },
    "application_mode": {
      "type": "string",
      "enum": [
        "\u00c1REA",
        "PLANTA"
      ],
      "description": "Modo de aplica\u00e7\u00e3o: por \u00e1rea (ha) ou por planta"
    },
    "dose": {
      "type": "number",
      "description": "Dose aplicada (por ha ou por planta, conforme application_mode)"
    },
    "total_quantity": {
      "type": "number",
      "description": "Quantidade total calculada"
    },
    "carencia": {
      "type": "string",
      "description": "Per\u00edodo de car\u00eancia (intervalo de seguran\u00e7a entre aplica\u00e7\u00e3o e colheita, ex: '30 dias')"
    },
    "obs": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do produto"
    },
    "sort_order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "recommendation_id",
    "product_name"
  ]
}