{
  "name": "CustomField",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "ID do OperationTemplate pai"
    },
    "field_label": {
      "type": "string",
      "description": "Nome/label do campo (ex: Pe\u00e7a trocada)"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "textarea",
        "photo",
        "video",
        "audio",
        "select_list",
        "multiple_choice",
        "hour_meter",
        "machine_selector",
        "implement_selector"
      ],
      "default": "text",
      "description": "Tipo do input"
    },
    "is_required": {
      "type": "boolean",
      "default": false,
      "description": "Se o campo \u00e9 obrigat\u00f3rio"
    },
    "input_stage": {
      "type": "string",
      "enum": [
        "planning",
        "registration",
        "both"
      ],
      "default": "both",
      "description": "Etapa em que o campo deve ser preenchido: planning (planejamento), registration (registro em campo) ou both (ambos)"
    },
    "show_on_label": {
      "type": "boolean",
      "default": false,
      "description": "Se o valor deste campo deve aparecer na etiqueta impressa"
    },
    "options": {
      "type": "string",
      "description": "JSON array de op\u00e7\u00f5es para select_list e multiple_choice (ex: [\"Op\u00e7\u00e3o 1\",\"Op\u00e7\u00e3o 2\"])"
    },
    "sort_order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "template_id",
    "field_label"
  ]
}