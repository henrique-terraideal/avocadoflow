{
  "name": "CustomField",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "ID do OperationTemplate pai"
    },
    "field_label": {
      "type": "string",
      "description": "Nome/label do campo (ex: Pe\u00e7a trocada)"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "textarea",
        "photo",
        "video",
        "audio"
      ],
      "default": "text",
      "description": "Tipo do input"
    },
    "is_required": {
      "type": "boolean",
      "default": false,
      "description": "Se o campo \u00e9 obrigat\u00f3rio"
    },
    "show_on_label": {
      "type": "boolean",
      "default": false,
      "description": "Se o valor deste campo deve aparecer na etiqueta impressa"
    },
    "sort_order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "template_id",
    "field_label"
  ]
}