{
  "name": "OperacaoManejo",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o de manejo"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Nutricao",
        "Irrigacao",
        "MIP",
        "Poda",
        "Solo",
        "Gestao"
      ],
      "description": "Categoria: Nutri\u00e7\u00e3o, Irriga\u00e7\u00e3o, MIP, Poda, Solo ou Gest\u00e3o"
    },
    "fase": {
      "type": "string",
      "enum": [
        "Implantacao",
        "Conducao"
      ],
      "description": "Fase do pomar: Implanta\u00e7\u00e3o ou Condu\u00e7\u00e3o"
    },
    "semanaInicio": {
      "type": "number",
      "description": "Semana inicial (1-52)"
    },
    "semanaFim": {
      "type": "number",
      "description": "Semana final (1-52)"
    },
    "pessoas": {
      "type": "number",
      "description": "N\u00famero de pessoas necess\u00e1rias"
    },
    "procedimentos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de procedimentos da opera\u00e7\u00e3o"
    },
    "insumos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de insumos utilizados"
    },
    "equipamentos": {
      "type": "string",
      "description": "Equipamentos utilizados"
    },
    "faseFenologica": {
      "type": "string",
      "description": "Fase fenol\u00f3gica associada"
    },
    "florada": {
      "type": "boolean",
      "default": false,
      "description": "True se a opera\u00e7\u00e3o ocorre durante florada (S0)"
    },
    "critico": {
      "type": "boolean",
      "default": false,
      "description": "True se \u00e9 opera\u00e7\u00e3o inegoci\u00e1vel"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o na categoria"
    }
  },
  "required": [
    "nome"
  ]
}