{
  "name": "FieldRecord",
  "type": "object",
  "properties": {
    "operator_name": {
      "type": "string",
      "description": "Nome do operador"
    },
    "operator_id": {
      "type": "string",
      "description": "ID do operador"
    },
    "operation": {
      "type": "string",
      "description": "Opera\u00e7\u00e3o realizada"
    },
    "orchard_number": {
      "type": "string",
      "description": "N\u00famero do pomar"
    },
    "start_time": {
      "type": "string",
      "description": "Hora de in\u00edcio (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "Hora de t\u00e9rmino (HH:MM)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da opera\u00e7\u00e3o"
    },
    "planned_date": {
      "type": "string",
      "format": "date",
      "description": "Data que a atividade foi planejada"
    },
    "observations": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "qr_scanned": {
      "type": "boolean",
      "default": false,
      "description": "Se foi preenchido via QR code"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que criou o registro"
    }
  },
  "required": [
    "operator_name",
    "operation",
    "orchard_number",
    "start_time",
    "end_time"
  ]
}