{
  "name": "FieldRecord",
  "type": "object",
  "properties": {
    "operator_name": {
      "type": "string",
      "description": "Nome do operador"
    },
    "operator_id": {
      "type": "string",
      "description": "ID do operador"
    },
    "operation": {
      "type": "string",
      "description": "Opera\u00e7\u00e3o realizada"
    },
    "orchard_number": {
      "type": "string",
      "description": "N\u00famero do pomar (lista de pomares separada por v\u00edrgula quando agrupada)"
    },
    "orchard_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de pomares da atividade agrupada"
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Manh\u00e3",
          "Tarde",
          "Noite"
        ]
      },
      "description": "Per\u00edodos do dia em que a atividade foi realizada (pode ter mais de um)"
    },
    "start_time": {
      "type": "string",
      "description": "Hora de in\u00edcio (HH:MM) \u2014 legado, usado apenas pelo cron\u00f4metro em campo"
    },
    "end_time": {
      "type": "string",
      "description": "Hora de t\u00e9rmino (HH:MM) \u2014 legado, usado apenas pelo cron\u00f4metro em campo"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da opera\u00e7\u00e3o"
    },
    "planned_date": {
      "type": "string",
      "format": "date",
      "description": "Data que a atividade foi planejada"
    },
    "observations": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "qr_scanned": {
      "type": "boolean",
      "default": false,
      "description": "Se foi preenchido via QR code"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que criou o registro"
    },
    "additional_details": {
      "type": "string",
      "description": "JSON com os valores dos campos customizados do template (ex: {\"campo\": \"valor\"})"
    }
  },
  "required": [
    "operator_name",
    "operation",
    "orchard_number"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}