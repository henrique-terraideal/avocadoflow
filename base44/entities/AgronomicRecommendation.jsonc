{
  "name": "AgronomicRecommendation",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo da RA (ex: PER1FERTI)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data prevista da aplica\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "description": "Tipo da recomenda\u00e7\u00e3o (ex: FERTIADUBA\u00c7\u00c3O, ADUBA\u00c7\u00c3O DE COBERTURA)"
    },
    "orchard_code": {
      "type": "string",
      "description": "C\u00f3digo do pomar"
    },
    "status": {
      "type": "string",
      "description": "Status (ex: PRODU\u00c7\u00c3O)"
    },
    "implement_id": {
      "type": "string",
      "description": "ID do implemento utilizado (para c\u00e1lculo de quantidade por tanque)"
    },
    "liters_per_ha": {
      "type": "number",
      "default": 1000,
      "description": "Volume de calda por hectare em litros (padr\u00e3o: 1000 L/ha)"
    },
    "machine_config": {
      "type": "string",
      "description": "Configura\u00e7\u00e3o/regulagem do maquin\u00e1rio"
    },
    "implement_config": {
      "type": "string",
      "description": "Configura\u00e7\u00e3o/regulagem do implemento"
    },
    "tractor": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o do trator utilizado (ex: John Deere 5078E)"
    },
    "marcha_trabalho": {
      "type": "string",
      "description": "Marcha de trabalho recomendada (ex: 4L)"
    },
    "rpm": {
      "type": "number",
      "description": "RPM do trator durante a aplica\u00e7\u00e3o (ex: 1800)"
    },
    "application_observations": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es espec\u00edficas da aplica\u00e7\u00e3o (ex: n\u00e3o aplicar com vento >10km/h)"
    },
    "climate_conditions": {
      "type": "string",
      "description": "Condi\u00e7\u00f5es clim\u00e1ticas ideais formatadas"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se a RA est\u00e1 ativa"
    }
  },
  "required": [
    "code"
  ]
}
